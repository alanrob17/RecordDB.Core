@page
@model RecordDB.Core.Pages.Records.IndexModel
@{
    ViewData["Title"] = "Records";

    const int GroupSize  = 15;
    int currentGroup     = (Model.CurrentPage - 1) / GroupSize;
    int groupStart       = currentGroup * GroupSize + 1;
    int groupEnd         = Math.Min(groupStart + GroupSize - 1, Model.TotalPages);
    int prevGroupLast    = groupStart - 1;
    int nextGroupFirst   = groupEnd + 1;
    int pageFrom         = (Model.CurrentPage - 1) * 20 + 1;
    int pageTo           = Math.Min(Model.CurrentPage * 20, Model.TotalCount);
}

<div class="page-header">
    <h1 class="page-title"><span>Records</span></h1>
    <span class="count-badge">
        🎵 @Model.TotalCount record@(Model.TotalCount != 1 ? "s" : "")
    </span>
</div>

<div class="list-toolbar">
    <form method="get" class="search-form" role="search">
        <div class="search-input-wrap">
            <span class="search-icon">🔍</span>
            <input type="text"
                   name="SearchTerm"
                   id="searchTerm"
                   class="search-input"
                   value="@Model.SearchTerm"
                   placeholder="Search by artist name or year…"
                   aria-label="Search by artist name or year" />
            @if (Model.IsSearching)
            {
                <a asp-page="./Index" class="search-clear" title="Clear search" aria-label="Clear search">✕</a>
            }
        </div>
        <button type="submit" class="btn-rdb btn-secondary-rdb">Search</button>
    </form>

    <a asp-page="./Create" class="btn-rdb btn-primary-rdb ms-auto">+ Add Record</a>
</div>

@if (Model.IsSearching)
{
    <p class="search-results-info">
        @if (Model.IsYearSearch)
        {
            @if (Model.TotalCount == 0)
            {
                <span>No records found recorded in year <strong>"@Model.SearchTerm"</strong>.</span>
            }
            else
            {
                <span>Found <strong>@Model.TotalCount</strong> record@(Model.TotalCount != 1 ? "s" : "") recorded in year <strong>"@Model.SearchTerm"</strong></span>
            }
        }
        else
        {
            @if (Model.TotalCount == 0)
            {
                <span>No records found for artist <strong>"@Model.SearchTerm"</strong>.</span>
            }
            else
            {
                <span>Found <strong>@Model.TotalCount</strong> record@(Model.TotalCount != 1 ? "s" : "") for artist <strong>"@Model.SearchTerm"</strong></span>
            }
        }
        &nbsp;— <a asp-page="./Index">Show all records</a>
    </p>
}

<div class="rdb-card">
    <table class="rdb-table">
        <thead>
            <tr>
                <th>Artist</th>
                <th>Title</th>
                <th>Year</th>
                <th>Media</th>
                <th>Rating</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @if (Model.Records.Count == 0)
            {
                <tr>
                    <td colspan="6" class="td-empty">No records found.</td>
                </tr>
            }
            else
            {
                @foreach (var item in Model.Records)
                {
                    <tr>
                        <td class="td-name">@item.ArtistName</td>
                        <td class="td-name">@item.Name</td>
                        <td class="td-center">@item.Recorded</td>
                        <td class="td-center">@item.Media</td>
                        <td class="td-center">@item.Rating</td>
                        <td class="td-actions">
                            <a asp-page="./Edit"    asp-route-id="@item.RecordId" class="action-link action-edit">Edit</a>
                            <a asp-page="./Details" asp-route-id="@item.RecordId" class="action-link action-details">Details</a>
                            <a asp-page="./Delete"  asp-route-id="@item.RecordId" class="action-link action-delete">Delete</a>
                        </td>
                    </tr>
                }
            }
        </tbody>
    </table>

    @if (Model.TotalPages > 1)
    {
        <div class="rdb-pagination">
            <span class="pagination-info">
                @if (Model.IsSearching)
                {
                    <span>Search results: </span>
                }
                Showing @pageFrom–@pageTo of @Model.TotalCount record@(Model.TotalCount != 1 ? "s" : "")
                &nbsp;·&nbsp; Page @Model.CurrentPage of @Model.TotalPages
            </span>
            <nav class="pagination-links" aria-label="Record pagination">

                @* ‹ Previous individual page *@
                @if (Model.CurrentPage > 1)
                {
                    <a class="page-btn" asp-page="./Index"
                       asp-route-pageNumber="@(Model.CurrentPage - 1)"
                       asp-route-SearchTerm="@Model.SearchTerm"
                       aria-label="Previous page" title="Previous page">‹</a>
                }
                else
                {
                    <span class="page-btn disabled" aria-disabled="true">‹</span>
                }

                @* « Jump to previous group of 15 *@
                @if (currentGroup > 0)
                {
                    <a class="page-btn page-btn-group" asp-page="./Index"
                       asp-route-pageNumber="@prevGroupLast"
                       asp-route-SearchTerm="@Model.SearchTerm"
                       title="Previous 15 pages">«</a>
                }

                @* 15 numbered page buttons for the current group *@
                @for (int p = groupStart; p <= groupEnd; p++)
                {
                    if (p == Model.CurrentPage)
                    {
                        <span class="page-btn active" aria-current="page">@p</span>
                    }
                    else
                    {
                        <a class="page-btn" asp-page="./Index"
                           asp-route-pageNumber="@p"
                           asp-route-SearchTerm="@Model.SearchTerm">@p</a>
                    }
                }

                @* » Jump to next group of 15 *@
                @if (nextGroupFirst <= Model.TotalPages)
                {
                    <a class="page-btn page-btn-group" asp-page="./Index"
                       asp-route-pageNumber="@nextGroupFirst"
                       asp-route-SearchTerm="@Model.SearchTerm"
                       title="Next 15 pages">»</a>
                }

                @* › Next individual page *@
                @if (Model.CurrentPage < Model.TotalPages)
                {
                    <a class="page-btn" asp-page="./Index"
                       asp-route-pageNumber="@(Model.CurrentPage + 1)"
                       asp-route-SearchTerm="@Model.SearchTerm"
                       aria-label="Next page" title="Next page">›</a>
                }
                else
                {
                    <span class="page-btn disabled" aria-disabled="true">›</span>
                }

            </nav>
        </div>
    }
</div>
