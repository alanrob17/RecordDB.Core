@page "{show}"
@model RecordDB.Core.Pages.Records.GetRecordsModel
@{
    ViewData["Title"] = Model.PageHeading;

    const int GroupSize = 15;
    int currentGroup    = (Model.CurrentPage - 1) / GroupSize;
    int groupStart      = currentGroup * GroupSize + 1;
    int groupEnd        = Math.Min(groupStart + GroupSize - 1, Model.TotalPages);
    int prevGroupLast   = groupStart - 1;
    int nextGroupFirst  = groupEnd + 1;
    int pageFrom        = (Model.CurrentPage - 1) * 20 + 1;
    int pageTo          = Math.Min(Model.CurrentPage * 20, Model.TotalCount);
}

<div class="page-header">
    <h1 class="page-title"><span>@Model.PageHeading</span></h1>
    <span class="count-badge">
        🎵 @Model.TotalCount record@(Model.TotalCount != 1 ? "s" : "")
    </span>
</div>

<div class="rdb-card">
    <table class="rdb-table">
        <thead>
            <tr>
                <th>Artist</th>
                <th>Title</th>
                <th>Field</th>
                <th>Year</th>
                <th>Rating</th>
                <th>Pressing</th>
                <th>Bought</th>
                <th>Discs</th>
                <th>Media</th>
            </tr>
        </thead>
        <tbody>
            @if (Model.Records.Count == 0)
            {
                <tr>
                    <td colspan="9" class="td-empty">No records found.</td>
                </tr>
            }
            else
            {
                @foreach (var item in Model.Records)
                {
                    <tr>
                        <td class="td-name"><a asp-page="./Index" asp-route-SearchTerm="@item.ArtistName">@item.ArtistName</a></td>
                        <td class="td-name"><a asp-page="./RecordView" asp-route-id="@item.RecordId">@item.Name</a></td>
                        <td class="td-center">@item.Field</td>
                        <td class="td-center">@item.Recorded</td>
                        <td class="td-center">@item.Rating</td>
                        <td class="td-center">@item.Pressing</td>
                        <td class="td-center">@item.Bought.ToShortDateString()</td>
                        <td class="td-center">@item.Discs</td>
                        <td class="td-center">@item.Media</td>
                    </tr>
                }
            }
        </tbody>
    </table>

    @if (Model.TotalPages > 1)
    {
        <div class="rdb-pagination">
            <span class="pagination-info">
                Showing @pageFrom–@pageTo of @Model.TotalCount record@(Model.TotalCount != 1 ? "s" : "")
                &nbsp;·&nbsp; Page @Model.CurrentPage of @Model.TotalPages
            </span>
            <nav class="pagination-links" aria-label="Record pagination">

                @* ‹ Previous individual page *@
                @if (Model.CurrentPage > 1)
                {
                    <a class="page-btn" asp-page="./GetRecords"
                       asp-route-show="@Model.Show"
                       asp-route-pageNumber="@(Model.CurrentPage - 1)"
                       aria-label="Previous page" title="Previous page">‹</a>
                }
                else
                {
                    <span class="page-btn disabled" aria-disabled="true">‹</span>
                }

                @* « Jump to previous group of 15 *@
                @if (currentGroup > 0)
                {
                    <a class="page-btn page-btn-group" asp-page="./GetRecords"
                       asp-route-show="@Model.Show"
                       asp-route-pageNumber="@prevGroupLast"
                       title="Previous 15 pages">«</a>
                }

                @* 15 numbered page buttons for the current group *@
                @for (int p = groupStart; p <= groupEnd; p++)
                {
                    if (p == Model.CurrentPage)
                    {
                        <span class="page-btn active" aria-current="page">@p</span>
                    }
                    else
                    {
                        <a class="page-btn" asp-page="./GetRecords"
                           asp-route-show="@Model.Show"
                           asp-route-pageNumber="@p">@p</a>
                    }
                }

                @* » Jump to next group of 15 *@
                @if (nextGroupFirst <= Model.TotalPages)
                {
                    <a class="page-btn page-btn-group" asp-page="./GetRecords"
                       asp-route-show="@Model.Show"
                       asp-route-pageNumber="@nextGroupFirst"
                       title="Next 15 pages">»</a>
                }

                @* › Next individual page *@
                @if (Model.CurrentPage < Model.TotalPages)
                {
                    <a class="page-btn" asp-page="./GetRecords"
                       asp-route-show="@Model.Show"
                       asp-route-pageNumber="@(Model.CurrentPage + 1)"
                       aria-label="Next page" title="Next page">›</a>
                }
                else
                {
                    <span class="page-btn disabled" aria-disabled="true">›</span>
                }

            </nav>
        </div>
    }
</div>
