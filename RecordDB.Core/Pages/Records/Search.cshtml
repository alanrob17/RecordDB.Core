@page
@model RecordDB.Core.Pages.Records.SearchModel
@{
    ViewData["Title"] = "Search Record";
}

<div class="page-header justify-content-center text-center mb-4">
    <h1 class="page-title">Search <span>Record</span></h1>
</div>

<div class="rdb-form-card" style="max-width: 560px; margin-top: 1.5rem;">
    <p class="text-center text-muted mb-4" style="font-size: 0.95rem;">
        Enter a partial or full Record Name to filter the dropdown, then select a record to view details.
    </p>

    <form method="post" id="recordSearchForm">
        @if (!ViewData.ModelState.IsValid && ViewData.ModelState.ContainsKey(string.Empty))
        {
            <div class="form-error-banner mb-3">
                @Html.ValidationSummary(false)
            </div>
        }

        <!-- Filter Field TextBox for Record.Name -->
        <div class="form-group mb-3">
            <label for="filterInput" class="form-label" style="font-weight: 600;">Filter by Record Name</label>
            <div class="input-group">
                <span class="input-group-text" style="background-color: var(--color-surface-alt, #f8f9fb); border-color: var(--color-border, #dde1ea); color: var(--color-text-muted, #5a6380);">🔍</span>
                <input type="text"
                       id="filterInput"
                       asp-for="FilterName"
                       placeholder="Type partial record name..."
                       class="form-control"
                       style="height: 3rem; border-radius: 0 var(--radius-sm, 6px) var(--radius-sm, 6px) 0;"
                       autocomplete="off" />
            </div>
            <small class="form-text text-muted" style="font-size: 0.82rem; margin-top: 0.25rem; display: block;">
                Type any part of the record name to instantly filter the list below.
            </small>
        </div>

        <!-- Dropdown List of Matching Items -->
        <div class="form-group mb-4">
            <label asp-for="SelectedRecordId" class="form-label" style="font-weight: 600;">Matching Records</label>
            <select asp-for="SelectedRecordId"
                    id="recordDropdown"
                    class="form-select"
                    size="8"
                    style="height: auto; border-radius: var(--radius-sm, 6px); font-size: 0.95rem; cursor: pointer;"
                    required>
                @if (Model.AllRecords != null && Model.AllRecords.Count > 0)
                {
                    @foreach (var record in Model.AllRecords)
                    {
                        var detailsList = new List<string>();
                        if (record.Recorded > 0) { detailsList.Add(record.Recorded.ToString()); }
                        if (!string.IsNullOrWhiteSpace(record.Media)) { detailsList.Add(record.Media); }
                        var detailsText = detailsList.Count > 0 ? $" ({string.Join(", ", detailsList)})" : "";
                        var completeTitle = $"{record.Name}{(!string.IsNullOrWhiteSpace(record.ArtistName) ? $" — {record.ArtistName}" : "")}{detailsText}";

                        <option value="@record.RecordId" title="@completeTitle" data-name="@completeTitle">
                            @completeTitle
                        </option>
                    }
                }
            </select>
            <div class="d-flex justify-content-between align-items-center mt-2">
                <span asp-validation-for="SelectedRecordId" class="field-validation-error"></span>
                <small id="recordCount" class="text-muted ms-auto" style="font-size: 0.85rem; font-weight: 500;"></small>
            </div>
        </div>

        <button type="submit" id="btnSubmit" class="btn-rdb btn-primary-rdb w-100" style="height: 3.5rem; font-size: 1.05rem; font-weight: 600; border-radius: var(--radius-md); display: flex; align-items: center; justify-content: center; gap: 0.5rem; transition: transform 0.2s;">
            <span>🎵</span> View Selected Record
        </button>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            const filterInput = document.getElementById('filterInput');
            const recordDropdown = document.getElementById('recordDropdown');
            const recordCount = document.getElementById('recordCount');
            const card = document.querySelector('.rdb-form-card');

            if (!filterInput || !recordDropdown) return;

            // Cache all option data for fast dynamic client-side filtering
            const allOptions = Array.from(recordDropdown.options).map(opt => ({
                value: opt.value,
                text: opt.text,
                title: opt.getAttribute('title') || opt.text,
                searchName: (opt.getAttribute('data-name') || opt.text).toLowerCase()
            }));

            function updateDropdown() {
                const query = filterInput.value.trim().toLowerCase();
                const currentValue = recordDropdown.value;

                recordDropdown.innerHTML = '';
                let matchCount = 0;

                allOptions.forEach(item => {
                    if (!query || item.searchName.includes(query)) {
                        const opt = document.createElement('option');
                        opt.value = item.value;
                        opt.textContent = item.text;
                        opt.title = item.title;
                        opt.setAttribute('data-name', item.searchName);
                        if (item.value === currentValue) {
                            opt.selected = true;
                        }
                        recordDropdown.appendChild(opt);
                        matchCount++;
                    }
                });

                // Auto-select first item if current selection is filtered out
                if (recordDropdown.options.length > 0 && recordDropdown.selectedIndex === -1) {
                    recordDropdown.selectedIndex = 0;
                }

                if (recordCount) {
                    recordCount.textContent = `${matchCount} record${matchCount === 1 ? '' : 's'} found`;
                }
            }

            filterInput.addEventListener('input', updateDropdown);

            // Double click option to submit immediately
            recordDropdown.addEventListener('dblclick', function () {
                if (recordDropdown.value) {
                    document.getElementById('recordSearchForm').submit();
                }
            });

            // Card zoom effect on input focus
            [filterInput, recordDropdown].forEach(input => {
                input.addEventListener('focus', () => {
                    if (card) {
                        card.style.transform = 'translateY(-2px)';
                        card.style.transition = 'transform 0.3s ease, box-shadow 0.3s ease';
                        card.style.boxShadow = '0 10px 25px rgba(79, 70, 229, 0.15)';
                    }
                });
                input.addEventListener('blur', () => {
                    if (card) {
                        card.style.transform = 'none';
                        card.style.boxShadow = 'var(--shadow-card)';
                    }
                });
            });

            // Initial render call
            updateDropdown();
        });
    </script>
}
