@page "{id:int}"
@model RecordDB.Core.Pages.Records.DetailsModel
@{
    ViewData["Title"] = "Record Details";
    string Val(string? s) => string.IsNullOrEmpty(s) ? "—" : s;
    string EmptyCls(string? s) => string.IsNullOrEmpty(s) ? "empty" : "";
}

<div class="page-header">
    <h1 class="page-title"><span>Record</span> Details</h1>
    <a asp-page="./Index" class="btn-rdb btn-secondary-rdb">← Back to Records</a>
</div>

<div class="rdb-detail-card">

    <div class="detail-row">
        <span class="detail-label">Record ID</span>
        <span class="detail-value">@Model.Record.RecordId</span>
    </div>
    <div class="detail-row">
        <span class="detail-label">Artist</span>
        <span class="detail-value @EmptyCls(Model.Record.ArtistName)">@Val(Model.Record.ArtistName)</span>
    </div>
    <div class="detail-row">
        <span class="detail-label">Title</span>
        <span class="detail-value @EmptyCls(Model.Record.Name)">@Val(Model.Record.Name)</span>
    </div>
    <div class="detail-row">
        <span class="detail-label">Field / Genre</span>
        <span class="detail-value @EmptyCls(Model.Record.Field)">@Val(Model.Record.Field)</span>
    </div>
    <div class="detail-row">
        <span class="detail-label">Year Recorded</span>
        <span class="detail-value">@(Model.Record.Recorded > 0 ? Model.Record.Recorded.ToString() : "—")</span>
    </div>
    <div class="detail-row">
        <span class="detail-label">Label</span>
        <span class="detail-value @EmptyCls(Model.Record.Label)">@Val(Model.Record.Label)</span>
    </div>
    <div class="detail-row">
        <span class="detail-label">Pressing</span>
        <span class="detail-value @EmptyCls(Model.Record.Pressing)">@Val(Model.Record.Pressing)</span>
    </div>
    <div class="detail-row">
        <span class="detail-label">Rating</span>
        <span class="detail-value @EmptyCls(Model.Record.Rating)">@Val(Model.Record.Rating)</span>
    </div>
    <div class="detail-row">
        <span class="detail-label">Discs</span>
        <span class="detail-value">@Model.Record.Discs</span>
    </div>
    <div class="detail-row">
        <span class="detail-label">Media</span>
        <span class="detail-value @EmptyCls(Model.Record.Media)">@Val(Model.Record.Media)</span>
    </div>
    <div class="detail-row">
        <span class="detail-label">Date Bought</span>
        <span class="detail-value">@Model.Record.Bought.ToString("d MMM yyyy")</span>
    </div>
    <div class="detail-row">
        <span class="detail-label">Cost</span>
        <span class="detail-value">@(Model.Record.Cost.HasValue ? Model.Record.Cost.Value.ToString("C") : "—")</span>
    </div>
    <div class="detail-row">
        <span class="detail-label">Cover Name</span>
        <span class="detail-value @EmptyCls(Model.Record.CoverName)">@Val(Model.Record.CoverName)</span>
    </div>
    <div class="detail-row">
        <span class="detail-label">Review</span>
        <span class="detail-value @EmptyCls(Model.Record.Review)">
            @(string.IsNullOrEmpty(Model.Record.Review) ? "No review." : Model.Record.Review)
        </span>
    </div>

</div>

<div class="form-actions mt-card">
    <a asp-page="./Edit"   asp-route-id="@Model.Record.RecordId" class="btn-rdb btn-primary-rdb">Edit</a>
    <a asp-page="./Delete" asp-route-id="@Model.Record.RecordId" class="btn-rdb btn-danger-rdb">Delete</a>
    <a asp-page="./Index"  class="btn-rdb btn-secondary-rdb">Back to List</a>
</div>
