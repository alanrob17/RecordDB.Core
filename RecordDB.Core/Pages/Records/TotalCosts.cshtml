@page
@model RecordDB.Core.Pages.Records.TotalCostsModel
@{
    ViewData["Title"] = "Artist Total Costs";

    const int GroupSize   = 10;
    int currentGroup      = (Model.CurrentPage - 1) / GroupSize;
    int groupStart        = currentGroup * GroupSize + 1;
    int groupEnd          = Math.Min(groupStart + GroupSize - 1, Model.TotalPages);
    int prevGroupLast     = groupStart - 1;
    int nextGroupFirst    = groupEnd + 1;
    int pageFrom          = (Model.CurrentPage - 1) * 20 + 1;
    int pageTo            = Math.Min(Model.CurrentPage * 20, Model.TotalCount);
}

<div class="total-costs-container">
    <div class="page-header">
        <h1 class="page-title"><span>Artist</span> Total Costs</h1>
        <span class="count-badge">
            💰 @Model.TotalCount artist@(Model.TotalCount != 1 ? "s" : "")
        </span>
    </div>

    <div class="rdb-card">
        <table class="rdb-table total-costs-table">
            <thead>
                <tr>
                    <th class="th-artist">Artist</th>
                    <th class="th-discs text-left">Total Discs</th>
                    <th class="th-cost text-end">Total Cost</th>
                </tr>
            </thead>
            <tbody>
                @if (Model.Totals.Count == 0)
                {
                    <tr>
                        <td colspan="3" class="td-empty">No total costs found.</td>
                    </tr>
                }
                else
                {
                    @foreach (var item in Model.Totals)
                    {
                        <tr>
                            <td class="td-name">@item.Name</td>
                            <td class="td-discs text-left">@item.TotalDiscs</td>
                            <td class="td-cost text-end">@item.TotalCost.ToString("C")</td>
                        </tr>
                    }
                }
            </tbody>
        </table>

        @if (Model.TotalPages > 1)
        {
            <div class="rdb-pagination">
                <span class="pagination-info">
                    Showing @pageFrom–@pageTo of @Model.TotalCount artists
                    &nbsp;·&nbsp; Page @Model.CurrentPage of @Model.TotalPages
                </span>
                <nav class="pagination-links" aria-label="Total costs pagination">

                    @* ‹ Previous individual page *@
                    @if (Model.CurrentPage > 1)
                    {
                        <a class="page-btn" asp-page="./TotalCosts"
                           asp-route-pageNumber="@(Model.CurrentPage - 1)"
                           aria-label="Previous page" title="Previous page">‹</a>
                    }
                    else
                    {
                        <span class="page-btn disabled" aria-disabled="true">‹</span>
                    }

                    @* « Jump to previous group of 10 *@
                    @if (currentGroup > 0)
                    {
                        <a class="page-btn page-btn-group" asp-page="./TotalCosts"
                           asp-route-pageNumber="@prevGroupLast"
                           title="Previous 10 pages">«</a>
                    }

                    @* 10 numbered page buttons for the current group *@
                    @for (int p = groupStart; p <= groupEnd; p++)
                    {
                        if (p == Model.CurrentPage)
                        {
                            <span class="page-btn active" aria-current="page">@p</span>
                        }
                        else
                        {
                            <a class="page-btn" asp-page="./TotalCosts" asp-route-pageNumber="@p">@p</a>
                        }
                    }

                    @* » Jump to next group of 10 *@
                    @if (nextGroupFirst <= Model.TotalPages)
                    {
                        <a class="page-btn page-btn-group" asp-page="./TotalCosts"
                           asp-route-pageNumber="@nextGroupFirst"
                           title="Next 10 pages">»</a>
                    }

                    @* › Next individual page *@
                    @if (Model.CurrentPage < Model.TotalPages)
                    {
                        <a class="page-btn" asp-page="./TotalCosts"
                           asp-route-pageNumber="@(Model.CurrentPage + 1)"
                           aria-label="Next page" title="Next page">›</a>
                    }
                    else
                    {
                        <span class="page-btn disabled" aria-disabled="true">›</span>
                    }

                </nav>
            </div>
        }
    </div>
</div>
