@page
@model RecordDB.Core.Pages.Records.CreateModel
@{
    ViewData["Title"] = "Add Record";
}

<div class="page-header">
    <h1 class="page-title"><span>Add</span> Record</h1>
    <a asp-page="./Index" class="btn-rdb btn-secondary-rdb">← Back to Records</a>
</div>

<div class="rdb-form-card">

    @if (!ViewData.ModelState.IsValid && ViewData.ModelState.ContainsKey(string.Empty))
    {
        <div class="form-error-banner">
            @Html.ValidationSummary(false)
        </div>
    }

    <form method="post">

        <div class="form-group">
            <label asp-for="Record.ArtistId">Artist</label>
            <select asp-for="Record.ArtistId" asp-items="Model.ArtistList"></select>
            <span asp-validation-for="Record.ArtistId" class="field-validation-error"></span>
        </div>

        <div class="form-group">
            <label asp-for="Record.Name">Title</label>
            <input type="text" asp-for="Record.Name" placeholder="Album title" />
            <span asp-validation-for="Record.Name" class="field-validation-error"></span>
        </div>

        <div class="form-row-2">
            <div class="form-group">
                <label asp-for="Record.Field">Field / Genre</label>
                <select asp-for="Record.Field">
                    <option value="">-- Select Field --</option>
                    <option>Acoustic</option>
                    <option>Audio</option>
                    <option>Blues</option>
                    <option>Classical</option>
                    <option>Comedy</option>
                    <option>Country</option>
                    <option>Folk</option>
                    <option>Fusion</option>
                    <option>Jazz</option>
                    <option>Pop</option>
                    <option>Rock</option>
                    <option>Soul</option>
                    <option>Soundtrack</option>
                    <option>World</option>
                </select>
                <span asp-validation-for="Record.Field" class="field-validation-error"></span>
            </div>
            <div class="form-group">
                <label asp-for="Record.Recorded">Year Recorded</label>
                <input type="text" asp-for="Record.Recorded" placeholder="e.g. 1975" />
                <span asp-validation-for="Record.Recorded" class="field-validation-error"></span>
            </div>
        </div>

        <div class="form-row-2">
            <div class="form-group">
                <label asp-for="Record.Label">Label</label>
                <input type="text" asp-for="Record.Label" placeholder="Record label" />
                <span asp-validation-for="Record.Label" class="field-validation-error"></span>
            </div>
            <div class="form-group">
                <label asp-for="Record.Pressing">Pressing</label>
                <select asp-for="Record.Pressing">
                    <option value="">-- Select Pressing --</option>
                    <option>Am</option>
                    <option>Aus</option>
                    <option>Can</option>
                    <option>Eng</option>
                    <option>Fra</option>
                    <option>Ger</option>
                    <option>Hk</option>
                    <option>Hol</option>
                    <option>Ita</option>
                    <option>Jap</option>
                    <option>Kor</option>
                    <option>Swe</option>
                    <option>Swi</option>
                </select>
                <span asp-validation-for="Record.Pressing" class="field-validation-error"></span>
            </div>
        </div>

        <div class="form-row-3">
            <div class="form-group">
                <label asp-for="Record.Rating">Rating</label>
                <select asp-for="Record.Rating">
                    <option value="">-- Select Rating --</option>
                    <option>*</option>
                    <option>**</option>
                    <option>***</option>
                    <option>****</option>
                </select>
                <span asp-validation-for="Record.Rating" class="field-validation-error"></span>
            </div>
            <div class="form-group">
                <label asp-for="Record.Discs">Discs</label>
                <select asp-for="Record.Discs">
                    <option value="">-- Select Discs --</option>
                    <option>1</option>
                    <option>2</option>
                    <option>3</option>
                    <option>4</option>
                    <option>5</option>
                    <option>6</option>
                </select>
                <span asp-validation-for="Record.Discs" class="field-validation-error"></span>
            </div>
            <div class="form-group">
                <label asp-for="Record.Media">Media</label>
                <select asp-for="Record.Media">
                    <option value="">-- Select Media --</option>
                    <option>CD</option>
                    <option>R</option>
                    <option>DVD</option>
                    <option>CD/DVD</option>
                    <option>Blu-ray</option>
                    <option>CD/Blu-ray</option>
                </select>
                <span asp-validation-for="Record.Media" class="field-validation-error"></span>
            </div>
        </div>

        <div class="form-row-2">
            <div class="form-group">
                <label asp-for="Record.Bought">Date Bought</label>
                <input type="date" asp-for="Record.Bought" />
                <span asp-validation-for="Record.Bought" class="field-validation-error"></span>
            </div>
            <div class="form-group">
                <label asp-for="Record.Cost">Cost</label>
                <input type="text" asp-for="Record.Cost" placeholder="0.00" />
                <span asp-validation-for="Record.Cost" class="field-validation-error"></span>
            </div>
        </div>

        <div class="form-group">
            <label asp-for="Record.CoverName">Cover Name</label>
            <input type="text" asp-for="Record.CoverName" placeholder="Image filename" />
            <span asp-validation-for="Record.CoverName" class="field-validation-error"></span>
        </div>

        <div class="form-group">
            <label asp-for="Record.Review">Review</label>
            <textarea asp-for="Record.Review" placeholder="Write a review…"></textarea>
            <span asp-validation-for="Record.Review" class="field-validation-error"></span>
        </div>

        <div class="form-actions">
            <button type="submit" class="btn-rdb btn-primary-rdb">Save Record</button>
            <a asp-page="./Index" class="btn-rdb btn-secondary-rdb">Cancel</a>
        </div>

    </form>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
