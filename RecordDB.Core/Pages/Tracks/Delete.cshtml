@page "{id:int}"
@model RecordDB.Core.Pages.Tracks.DeleteModel
@{
    ViewData["Title"] = "Delete Track";
}

<div class="page-header">
    <h1 class="page-title"><span>Delete</span> Track</h1>
    <a asp-page="./Index" class="btn-rdb btn-secondary-rdb">← Back to Tracks</a>
</div>

<div class="rdb-danger-card">

    <div class="danger-header">
        <span>⚠️</span>
        <h2>Confirm Deletion</h2>
    </div>

    <div class="danger-body">

        <p class="danger-warning">
            You are about to permanently delete this track.
            This action <strong>cannot be undone</strong>.
        </p>

        <div class="rdb-detail-card" style="margin-bottom: 1.5rem;">
            <div class="detail-row">
                <span class="detail-label">Track ID</span>
                <span class="detail-value">@Model.Track.TrackId</span>
            </div>
            <div class="detail-row">
                <span class="detail-label">Artist</span>
                <span class="detail-value @(string.IsNullOrEmpty(Model.Track.ArtistName) ? "empty" : "")">
                    @(string.IsNullOrEmpty(Model.Track.ArtistName) ? "—" : Model.Track.ArtistName)
                </span>
            </div>
            <div class="detail-row">
                <span class="detail-label">Record</span>
                <span class="detail-value @(string.IsNullOrEmpty(Model.Track.Name) ? "empty" : "")">
                    @(string.IsNullOrEmpty(Model.Track.Name) ? "—" : Model.Track.Name)
                </span>
            </div>
            <div class="detail-row">
                <span class="detail-label">Disc No</span>
                <span class="detail-value">@Model.Track.DiscNo</span>
            </div>
            <div class="detail-row">
                <span class="detail-label">Track No</span>
                <span class="detail-value">@(Model.Track.TrackNo.HasValue ? Model.Track.TrackNo.Value.ToString() : "—")</span>
            </div>
            <div class="detail-row">
                <span class="detail-label">Track Name</span>
                <span class="detail-value @(string.IsNullOrEmpty(Model.Track.TrackName) ? "empty" : "")">
                    @(string.IsNullOrEmpty(Model.Track.TrackName) ? "—" : Model.Track.TrackName)
                </span>
            </div>
        </div>

        <form method="post">
            <input type="hidden" asp-for="TrackId" />
            <div class="form-actions">
                <button type="submit" class="btn-rdb btn-danger-rdb">Yes, Delete Track</button>
                <a asp-page="./Index"   class="btn-rdb btn-secondary-rdb">Cancel</a>
                <a asp-page="./Details" asp-route-id="@Model.Track.TrackId"
                   class="btn-rdb btn-secondary-rdb">View Details</a>
            </div>
        </form>

    </div>
</div>
