@page "{id:int}"
@model RecordDB.Core.Pages.Tracks.EditModel
@{
    ViewData["Title"] = "Edit Track";
}

<div class="page-header">
    <h1 class="page-title"><span>Edit</span> Track</h1>
    <a asp-page="./Index" class="btn-rdb btn-secondary-rdb">← Back to Tracks</a>
</div>

<div class="rdb-form-card">

    <form method="post">
        <input type="hidden" asp-for="Track.TrackId" />
        <input type="hidden" asp-for="Track.DiscId" />

        <div class="form-group">
            <span class="detail-label">Artist:</span>
            <span class="detail-value">@Model.ArtistName</span>
        </div>

        <div class="form-group">
            <span class="detail-label">Record:</span>
            <span class="detail-value">@Model.RecordName</span>
        </div>

        <div class="form-group">
            <label asp-for="Track.TrackNo">Track Number</label>
            <input type="number" asp-for="Track.TrackNo" placeholder="Track number" required />
            <span asp-validation-for="Track.TrackNo" class="field-validation-error"></span>
        </div>

        <div class="form-group">
            <label asp-for="Track.Name">Track Name</label>
            <input type="text" asp-for="Track.Name" placeholder="Track name" />
            <span asp-validation-for="Track.Name" class="field-validation-error"></span>
        </div>

        <div class="form-group">
            <label asp-for="Track.TrackLength">Length (seconds)</label>
            <input type="number" asp-for="Track.TrackLength" placeholder="Length in seconds" />
            <span asp-validation-for="Track.TrackLength" class="field-validation-error"></span>
        </div>

        <div class="form-group">
            <label asp-for="Track.Extended">Extended Info</label>
            <input type="text" asp-for="Track.Extended" placeholder="Extended info (optional)" />
            <span asp-validation-for="Track.Extended" class="field-validation-error"></span>
        </div>

        <div class="form-actions">
            <button type="submit" class="btn-rdb btn-primary-rdb">Save Changes</button>
            <a asp-page="./Index" class="btn-rdb btn-secondary-rdb">Cancel</a>
            <a asp-page="./Details" asp-route-id="@Model.Track.TrackId"
               class="btn-rdb btn-secondary-rdb">View Details</a>
        </div>
    </form>

</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
