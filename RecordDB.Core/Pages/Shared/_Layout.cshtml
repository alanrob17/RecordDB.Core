<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content="RecordDB — manage your vinyl and CD collection" />
    <title>@ViewData["Title"] - RecordDB</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/RecordDB.Core.styles.css" asp-append-version="true" />
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-sm">
            <div class="container">
                <a class="navbar-brand" asp-area="" asp-page="/Index">RecordDB</a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse"
                        data-bs-target=".navbar-collapse" aria-controls="navbarSupportedContent"
                        aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between">
                    <ul class="navbar-nav flex-grow-1">
                        <li class="nav-item">
                            <a class="nav-link" asp-area="" asp-page="/Index">Home</a>
                        </li>
                        <li class="nav-item dropdown">
                            <a class="nav-link site-nav-link dropdown-toggle" href="#" id="searchDropdown" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                                Search
                            </a>
                            <ul class="dropdown-menu" aria-labelledby="searchDropdown">
                                <li><a class="dropdown-item" asp-area="" asp-page="/Artists/Search"><span class="d-inline-block bg-warning rounded-circle p-1"></span>&nbsp;&nbsp;Artist Search</a></li>
                                <li><a class="dropdown-item" asp-area="" asp-page="/Records/Search"><span class="d-inline-block bg-success rounded-circle p-1"></span>&nbsp;&nbsp;Record Search</a></li>
                            </ul>
                        </li>
                        <li class="nav-item dropdown">
                            <a class="nav-link dropdown-toggle" href="#" id="maintenanceDropdown" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                                Maintenance
                            </a>
                            <ul class="dropdown-menu" aria-labelledby="maintenanceDropdown">
                                <li class="nav-item dropdown-submenu">
                                    <a class="dropdown-item dropdown-toggle" href="#" id="artistsSubmenu" role="button" data-bs-toggle="dropdown" aria-expanded="false">Artists</a>
                                    <ul class="dropdown-menu" aria-labelledby="artistsSubmenu">
                                        <li><a class="dropdown-item" asp-area="" asp-page="/Artists/Index"><span class="d-inline-block bg-success rounded-circle p-1"></span>&nbsp;&nbsp;Artist List</a></li>
                                        <li><a class="dropdown-item" asp-area="" asp-page="/Artists/Create"><span class="d-inline-block bg-warning rounded-circle p-1"></span>&nbsp;&nbsp;Create an Artist</a></li>
                                        <li><a class="dropdown-item" asp-area="" asp-page="/Artists/EditArtist"><span class="d-inline-block bg-info rounded-circle p-1"></span>&nbsp;&nbsp;Edit an Artist</a></li>
                                        <li><a class="dropdown-item" asp-area="" asp-page="/Artists/DeleteArtist"><span class="d-inline-block bg-danger rounded-circle p-1"></span>&nbsp;&nbsp;Delete an Artist</a></li>
                                    </ul>
                                </li>
                                <li class="nav-item dropdown-submenu">
                                    <a class="dropdown-item dropdown-toggle" href="#" id="recordsSubmenu" role="button" data-bs-toggle="dropdown" aria-expanded="false">Records</a>
                                    <ul class="dropdown-menu" aria-labelledby="recordsSubmenu">
                                        <li><a class="dropdown-item" asp-area="" asp-page="/Records/Index"><span class="d-inline-block bg-success rounded-circle p-1"></span>&nbsp;&nbsp;Record List</a></li>                                        
                                        <li><a class="dropdown-item" asp-area="" asp-page="/Records/Create"><span class="d-inline-block bg-warning rounded-circle p-1"></span>&nbsp;&nbsp;Create a Record</a></li>
                                        <li><a class="dropdown-item" asp-area="" asp-page="/Records/EditRecord"><span class="d-inline-block bg-info rounded-circle p-1"></span>&nbsp;&nbsp;Edit a Record</a></li>
                                        <li><a class="dropdown-item" asp-area="" asp-page="/Records/DeleteRecord"><span class="d-inline-block bg-danger rounded-circle p-1"></span>&nbsp;&nbsp;Delete a Record</a></li>
                                    </ul>
                                </li>
                                <li class="nav-item dropdown-submenu">
                                    <a class="dropdown-item dropdown-toggle" href="#" id="discsSubmenu" role="button" data-bs-toggle="dropdown" aria-expanded="false">Discs</a>
                                    <ul class="dropdown-menu" aria-labelledby="discsSubmenu">
                                        <li><a class="dropdown-item" asp-area="" asp-page="/Discs/Index"><span class="d-inline-block bg-success rounded-circle p-1"></span>&nbsp;&nbsp;Disc List</a></li>
                                        <li><a class="dropdown-item" asp-area="" asp-page="/Discs/Create"><span class="d-inline-block bg-warning rounded-circle p-1"></span>&nbsp;&nbsp;Create a Disc</a></li>
                                    </ul>
                                </li>
                            </ul>
                        </li>
                        <li class="nav-item dropdown">
                            <a class="nav-link site-nav-link dropdown-toggle" href="#" id="statisticsDropdown" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                                Statistics
                            </a>
                            <ul class="dropdown-menu" aria-labelledby="statisticsDropdown">
                                <li><a class="dropdown-item" asp-area="" asp-page="/Records/TotalCosts"><span class="d-inline-block bg-warning rounded-circle p-1"></span>&nbsp;&nbsp;Artist Totals</a></li>
                                <li><a class="dropdown-item" asp-area="" asp-page="/Statistics/Index"><span class="d-inline-block bg-success rounded-circle p-1"></span>&nbsp;&nbsp;Statistics</a></li>
                            </ul>
                        </li>
                    </ul>
                </div>
            </div>
        </nav>
    </header>

    <div class="container">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <footer>
        <div class="container">
            &copy; @DateTime.Now.Year Alan Robson &mdash; RecordDB
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
