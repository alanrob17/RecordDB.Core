@page
@model RecordDB.Core.Pages.Artists.NoBiographyModel
@{
    ViewData["Title"] = "Artists – No Biography";

    const int GroupSize   = 15;
    int currentGroup      = (Model.CurrentPage - 1) / GroupSize;
    int groupStart        = currentGroup * GroupSize + 1;
    int groupEnd          = Math.Min(groupStart + GroupSize - 1, Model.TotalPages);
    int prevGroupLast     = groupStart - 1;
    int nextGroupFirst    = groupEnd + 1;
    int pageFrom          = (Model.CurrentPage - 1) * 20 + 1;
    int pageTo            = Math.Min(Model.CurrentPage * 20, Model.TotalCount);
}

<div class="page-header">
    <h1 class="page-title"><span>Artists</span> – No Biography</h1>
    <span class="count-badge">
        🎤 @Model.TotalCount artist@(Model.TotalCount != 1 ? "s" : "") without biography
    </span>
</div>

<div class="list-toolbar">
    <form method="get" class="search-form" role="search">
        <div class="search-input-wrap">
            <span class="search-icon">🔍</span>
            <input type="text"
                   name="SearchTerm"
                   id="searchTerm"
                   class="search-input"
                   value="@Model.SearchTerm"
                   placeholder="Search artists…"
                   aria-label="Search artists" />
            @if (Model.IsSearching)
            {
                <a asp-page="./NoBiography" class="search-clear" title="Clear search" aria-label="Clear search">✕</a>
            }
        </div>
        <button type="submit" class="btn-rdb btn-secondary-rdb">Search</button>
    </form>
</div>

@if (Model.IsSearching)
{
    <p class="search-results-info">
        @if (Model.TotalCount == 0)
        {
            <span>No artists without biography found for <strong>"@Model.SearchTerm"</strong>.</span>
        }
        else
        {
            <span>Found <strong>@Model.TotalCount</strong> artist@(Model.TotalCount != 1 ? "s" : "") matching <strong>"@Model.SearchTerm"</strong></span>
        }
        &nbsp;— <a asp-page="./NoBiography">Show all artists without biography</a>
    </p>
}

<div class="rdb-card">
    <table class="rdb-table">
        <thead>
            <tr>
                <th>Name</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @if (Model.Artists.Count == 0)
            {
                <tr>
                    <td colspan="2" class="td-empty">No artists found.</td>
                </tr>
            }
            else
            {
                @foreach (var item in Model.Artists)
                {
                    <tr>
                        <td class="td-name">@item.Name</td>
                        <td class="td-actions">
                            <a asp-page="./Edit" asp-route-id="@item.ArtistId" class="btn-rdb btn-primary-rdb btn-sm">Add Biography</a>
                        </td>
                    </tr>
                }
            }
        </tbody>
    </table>

    @if (!Model.IsSearching && Model.TotalPages > 1)
    {
        <div class="rdb-pagination">
            <span class="pagination-info">
                Showing @pageFrom–@pageTo of @Model.TotalCount artists
                &nbsp;·&nbsp; Page @Model.CurrentPage of @Model.TotalPages
            </span>
            <nav class="pagination-links" aria-label="Artist pagination">

                @* ‹ Previous individual page *@
                @if (Model.CurrentPage > 1)
                {
                    <a class="page-btn" asp-page="./NoBiography"
                       asp-route-pageNumber="@(Model.CurrentPage - 1)"
                       aria-label="Previous page" title="Previous page">‹</a>
                }
                else
                {
                    <span class="page-btn disabled" aria-disabled="true">‹</span>
                }

                @* « Jump to previous group of 15 *@
                @if (currentGroup > 0)
                {
                    <a class="page-btn page-btn-group" asp-page="./NoBiography"
                       asp-route-pageNumber="@prevGroupLast"
                       aria-label="Previous 15 pages" title="Previous 15 pages">«</a>
                }

                @* The 15 numbered page buttons for the current group *@
                @for (int p = groupStart; p <= groupEnd; p++)
                {
                    if (p == Model.CurrentPage)
                    {
                        <span class="page-btn active" aria-current="page">@p</span>
                    }
                    else
                    {
                        <a class="page-btn" asp-page="./NoBiography" asp-route-pageNumber="@p">@p</a>
                    }
                }

                @* » Jump to next group of 15 *@
                @if (nextGroupFirst <= Model.TotalPages)
                {
                    <a class="page-btn page-btn-group" asp-page="./NoBiography"
                       asp-route-pageNumber="@nextGroupFirst"
                       aria-label="Next 15 pages" title="Next 15 pages">»</a>
                }

                @* › Next individual page *@
                @if (Model.CurrentPage < Model.TotalPages)
                {
                    <a class="page-btn" asp-page="./NoBiography"
                       asp-route-pageNumber="@(Model.CurrentPage + 1)"
                       aria-label="Next page" title="Next page">›</a>
                }
                else
                {
                    <span class="page-btn disabled" aria-disabled="true">›</span>
                }

            </nav>
        </div>
    }
</div>
