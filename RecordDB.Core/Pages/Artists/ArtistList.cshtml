@page
@model RecordDB.Core.Pages.Artists.ArtistListModel
@{
    ViewData["Title"] = "Artist List";
}

<div class="artist-list-container">
    <div class="page-header justify-content-center text-center flex-column mb-4">
        <h1 class="page-title"><span>Artist & Record</span> List</h1>
        <span class="count-badge mt-2">
            🎤 @Model.ArtistGroups.Count artist@(Model.ArtistGroups.Count != 1 ? "s" : "")
        </span>
    </div>

    <div class="rdb-card artist-list-card">
        @if (Model.ArtistGroups.Count == 0)
        {
            <div class="text-center py-5 text-muted">No artists found.</div>
        }
        else
        {
            <div class="artist-records-wrapper">
                @foreach (var group in Model.ArtistGroups)
                {
                    <section class="artist-group-item">
                        <h2 class="artist-heading">
                            <a href="/Artists/Details/@group.Artist.ArtistId" class="artist-link">@group.Artist.Name</a>
                        </h2>

                        @if (group.Records.Count > 0)
                        {
                            <ul class="record-items-list">
                                @foreach (var record in group.Records)
                                {
                                    <li class="record-item">
                                        <a href="/Records/Details/@record.RecordId" class="record-link">@record.Recorded - @record.Name (@record.Media)</a>
                                    </li>
                                }
                            </ul>
                        }
                        else
                        {
                            <p class="no-records-text">No records</p>
                        }
                    </section>
                }
            </div>
        }
    </div>
</div>
