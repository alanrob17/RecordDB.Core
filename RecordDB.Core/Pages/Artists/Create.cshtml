@page
@model RecordDB.Core.Pages.Artists.CreateModel
@{
    ViewData["Title"] = "Add Artist";
}

<div class="page-header">
    <h1 class="page-title"><span>Add</span> Artist</h1>
    <a asp-page="./Index" class="btn-rdb btn-secondary-rdb">← Back to Artists</a>
</div>

<div class="rdb-form-card">

    @if (!ViewData.ModelState.IsValid && ViewData.ModelState.ContainsKey(string.Empty))
    {
        <div class="form-error-banner">
            @Html.ValidationSummary(false)
        </div>
    }

    <form method="post">

        <div class="form-group">
            <label asp-for="Artist.FirstName">First Name</label>
            <input type="text" asp-for="Artist.FirstName" placeholder="e.g. David" />
            <span asp-validation-for="Artist.FirstName" class="field-validation-error"></span>
        </div>

        <div class="form-group">
            <label asp-for="Artist.LastName">Last Name</label>
            <input type="text" asp-for="Artist.LastName" placeholder="e.g. Bowie" />
            <span asp-validation-for="Artist.LastName" class="field-validation-error"></span>
        </div>

        <div class="form-group">
            <label asp-for="Artist.Biography">Biography</label>
            <textarea asp-for="Artist.Biography" placeholder="Write a short biography…"></textarea>
            <span asp-validation-for="Artist.Biography" class="field-validation-error"></span>
        </div>

        <div class="form-actions">
            <button type="submit" class="btn-rdb btn-primary-rdb">Save Artist</button>
            <a asp-page="./Index" class="btn-rdb btn-secondary-rdb">Cancel</a>
        </div>

    </form>

</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
