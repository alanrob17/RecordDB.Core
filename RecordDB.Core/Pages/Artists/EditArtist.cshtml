@page "{id:int?}"
@model RecordDB.Core.Pages.Artists.EditArtistModel
@{
    ViewData["Title"] = "Edit Artist";
}

<div class="page-header">
    <h1 class="page-title"><span>Edit</span> Artist</h1>
    <a asp-page="./Index" class="btn-rdb btn-secondary-rdb">← Back to Artists</a>
</div>

<div class="rdb-form-card">

    <div class="form-group mb-4">
        <label for="artistSelect">Select Artist to Edit</label>
        <select id="artistSelect"
                class="form-select"
                asp-for="SelectedArtistId"
                asp-items="Model.ArtistList"
                onchange="if(this.value && this.value > 0) { window.location.href = '/Artists/EditArtist/' + this.value; }">
        </select>
    </div>

    @if (Model.Artist != null && Model.Artist.ArtistId > 0)
    {
        <form method="post">
            <input type="hidden" asp-for="Artist.ArtistId" />

            <div class="form-group">
                <label asp-for="Artist.FirstName">First Name</label>
                <input type="text" asp-for="Artist.FirstName" placeholder="First name" />
                <span asp-validation-for="Artist.FirstName" class="field-validation-error"></span>
            </div>

            <div class="form-group">
                <label asp-for="Artist.LastName">Last Name</label>
                <input type="text" asp-for="Artist.LastName" placeholder="Last name" />
                <span asp-validation-for="Artist.LastName" class="field-validation-error"></span>
            </div>

            <div class="form-group">
                <label asp-for="Artist.Name">Display Name</label>
                <input type="text" asp-for="Artist.Name" placeholder="Display name" />
                <span asp-validation-for="Artist.Name" class="field-validation-error"></span>
            </div>

            <div class="form-group">
                <label asp-for="Artist.Biography">Biography</label>
                <textarea asp-for="Artist.Biography" placeholder="Artist biography…"></textarea>
                <span asp-validation-for="Artist.Biography" class="field-validation-error"></span>
            </div>

            <div class="form-actions">
                <button type="submit" class="btn-rdb btn-primary-rdb">Save Changes</button>
                <a asp-page="./Index" class="btn-rdb btn-secondary-rdb">Cancel</a>
                <a asp-page="./Details" asp-route-id="@Model.Artist.ArtistId"
                   class="btn-rdb btn-secondary-rdb">View Details</a>
            </div>
        </form>
    }
    else
    {
        <p class="text-muted text-center my-4">Please select an artist from the dropdown list above to edit their details.</p>
    }

</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
