@page
@model RecordDB.Core.Pages.Statistics.IndexModel
@{
    ViewData["Title"] = "Statistics";
}

<div class="statistics-container">
    <div class="page-header">
        <h1 class="page-title"><span>Statistics</span></h1>
    </div>

    <div class="rdb-card">
        <table class="rdb-table total-costs-table">
        <thead>
            <tr>
                    <th class="th-artist">Statistics</th>
                    <th class="th-cost">Total</th>
            </tr>
        </thead>
        <tr>
                <td class="td-name  text-left"><strong>Number of Discs bought in 2022</strong></td>
            <td class="td-name text-end">@Model.Statistics.Disks2022</td>
        </tr>
        <tr>
                <td class="td-name  text-left"><strong>Total Amount spent on Discs in 2022</strong></td>
            <td class="td-name text-end">@Model.Statistics.Cost2022.ToString("c")</td>
        </tr>
        <tr>
            <td class="td-name  text-left"><strong>Average cost of a Disc in 2022</strong></td>
            <td class="td-name text-end">@Model.Statistics.Av2022.ToString("c")</td>
