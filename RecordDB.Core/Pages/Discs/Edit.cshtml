@page "{id:int}"
@model RecordDB.Core.Pages.Discs.EditModel
@{
    ViewData["Title"] = "Edit Disc";
}

<div class="page-header">
    <h1 class="page-title"><span>Edit</span> Disc</h1>
    <a asp-page="./Index" class="btn-rdb btn-secondary-rdb">← Back to Discs</a>
</div>

<div class="rdb-form-card">

    <form method="post">
        <input type="hidden" asp-for="Disc.DiscId" />
        <input type="hidden" asp-for="Disc.RecordId" />

        <div class="form-group">
            <span class="detail-label">Artist:</span>
            <span class="detail-value">@Model.Disc.ArtistName</span>
        </div>

        <div class="form-group">
            <span class="detail-label">Record:</span>
            <span class="detail-value">
                <a asp-page="/Records/Details" asp-route-id="@Model.Disc.RecordId">@Model.Disc.Name</a>
            </span>
        </div>

        <div class="form-group">
            <label asp-for="Disc.DiscNo">Disc Number</label>
            <input type="number" asp-for="Disc.DiscNo" placeholder="Disc number" required />
            <span asp-validation-for="Disc.DiscNo" class="field-validation-error"></span>
        </div>

        <div class="form-group">
            <label asp-for="Disc.FreeDbDiscId">FreeDb Disc ID</label>
            <input type="number" asp-for="Disc.FreeDbDiscId" placeholder="FreeDb Disc ID" />
            <span asp-validation-for="Disc.FreeDbDiscId" class="field-validation-error"></span>
        </div>

        <div class="form-group">
            <label asp-for="Disc.FreeDbId">FreeDb String ID</label>
            <input type="text" asp-for="Disc.FreeDbId" placeholder="FreeDb String ID" />
            <span asp-validation-for="Disc.FreeDbId" class="field-validation-error"></span>
        </div>

        <div class="form-group">
            <label asp-for="Disc.Length">Length (seconds)</label>
            <input type="number" asp-for="Disc.Length" placeholder="Length in seconds" />
            <span asp-validation-for="Disc.Length" class="field-validation-error"></span>
        </div>

        <div class="form-actions">
            <button type="submit" class="btn-rdb btn-primary-rdb">Save Changes</button>
            <a asp-page="./Index" class="btn-rdb btn-secondary-rdb">Cancel</a>
            <a asp-page="./Details" asp-route-id="@Model.Disc.DiscId"
               class="btn-rdb btn-secondary-rdb">View Details</a>
        </div>
    </form>

</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
